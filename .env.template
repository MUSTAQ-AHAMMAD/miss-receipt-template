# ================================================================================
# ORACLE FUSION API CONFIGURATION TEMPLATE
# ================================================================================
# Copy this file to .env and fill in your actual Oracle Fusion credentials
#
# NEVER commit the .env file to version control!
# ================================================================================

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
UPLOAD_DIR=/tmp/oracle_fusion_ui
REPORTS_DIR=/tmp/oracle_fusion_reports

# Oracle Fusion REST API Configuration
# ------------------------------------------------------------------------------
# REST API is used for standard receipt uploads
ORACLE_API_ENDPOINT=https://your-oracle-instance.fa.oracle.com/fscmRestApi/resources/11.13.18.05
ORACLE_API_USERNAME=your-username
ORACLE_API_PASSWORD=your-password

# Oracle Fusion SOAP API Configuration (Optional)
# ------------------------------------------------------------------------------
# SOAP API can be used for more complex operations
# Example WSDL URLs for different services:
ORACLE_SOAP_WSDL_RECEIVABLES=https://your-oracle-instance.fa.oracle.com/fscmService/ReceivablesInvoicesService?WSDL
ORACLE_SOAP_WSDL_CASHMANAGEMENT=https://your-oracle-instance.fa.oracle.com/fscmService/CashManagementService?WSDL
ORACLE_SOAP_USERNAME=your-username
ORACLE_SOAP_PASSWORD=your-password

# API Configuration
# ------------------------------------------------------------------------------
# Enable/Disable mock mode (set to false to use real API)
API_MOCK_MODE=true

# Maximum number of retries for failed API calls
API_MAX_RETRIES=3

# Timeout for API calls (in seconds)
API_TIMEOUT=30

# Enable detailed API logging
API_DEBUG_LOGGING=true

# ================================================================================
# USAGE INSTRUCTIONS
# ================================================================================
# 1. Copy this file: cp .env.template .env
# 2. Fill in your Oracle Fusion credentials in .env
# 3. Update ORACLE_API_ENDPOINT with your actual Oracle instance URL
# 4. Set API_MOCK_MODE=false to enable real API calls
# 5. Restart the application: python app.py
# ================================================================================
